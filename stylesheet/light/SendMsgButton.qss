SendMsgButton {
    background-color: transparent;
    border: 1px solid rgb(229, 229, 229); 
    border-radius: 15px;
}

SendMsgButton:hover {
    background-color: rgba(0, 0, 0, 13);
}

SendMsgButton:pressed {
    background-color: rgba(0, 0, 0, 26);
}

SendMsgButton:disabled {
    background-color: transparent;
}
