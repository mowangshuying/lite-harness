SendMsgButton {
    background-color: transparent;
    border: 1px solid rgb(229, 229, 229); 
    border-radius: 15px;
}

SendMsgButton:hover {
    background-color: rgba(0, 0, 0, 13);
}

SendMsgButton:pressed {
    background-color: rgba(0, 0, 0, 26);
}

SendMsgButton:disabled {
    background-color: transparent;
}

/* 停止形态（回合运行中）：强调蓝淡染底 + 描边（与侧栏 running 状态灯同源色；
   琥珀专属审批警示不占用），传达"可中止运行中回合"；hover/pressed 逐档加深
   （属性选择器置后，压过中性态规则） */
SendMsgButton[stopMode="true"] {
    background-color: rgba(0, 90, 158, 16);
    border: 1px solid rgba(0, 90, 158, 110);
}

SendMsgButton[stopMode="true"]:hover {
    background-color: rgba(0, 90, 158, 30);
}

SendMsgButton[stopMode="true"]:pressed {
    background-color: rgba(0, 90, 158, 46);
}
