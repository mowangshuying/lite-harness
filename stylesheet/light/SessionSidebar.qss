/* light —— SessionSidebar 会话侧边栏 */

#SessionSidebar {
    /* 底色与左侧导航列对齐（LiteHarnessNavAlign.qss 基准） */
    background: rgb(249, 249, 249);
    border: none;
    /* 左/顶边框线与左侧导航列边框同源取色 */
    border-left: 1px solid rgb(229, 229, 229);
    border-top: 1px solid rgb(229, 229, 229);
}

/* ---- 面板头部 ---- */
#sbPanelTitle {
    color: rgb(96, 96, 96);
    font: bold 12px "Segoe UI";
}
#sidebarHideBtn, #sidebarRestoreBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
#sidebarHideBtn:hover, #sidebarRestoreBtn:hover {
    background: rgba(0, 0, 0, 18);
}
#sidebarHideBtn:pressed, #sidebarRestoreBtn:pressed {
    background: rgba(0, 0, 0, 32);
}

/* ---- 会话标题 / 模型 ---- */
#sbSessTitle {
    color: rgb(60, 60, 60);
    font: bold 15px "Segoe UI";
}
#sbSessModel {
    color: rgb(120, 120, 120);
    font: 12px "Consolas";
}
#sbSeparator {
    background: rgba(0, 0, 0, 14);
    border: none;
}

/* ---- 滚动容器透明（透出面板底色） ---- */
#sbScroll { background: transparent; border: none; }
#sbScroll > QWidget > QWidget { background: transparent; border: none; }
#sbScrollInner { background: transparent; }
#sbScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 1px 2px 1px;
}
#sbScroll QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 42);
    border-radius: 3px;
    min-height: 28px;
}
#sbScroll QScrollBar::add-line:vertical, #sbScroll QScrollBar::sub-line:vertical {
    height: 0;
}
#sbScroll QScrollBar::add-page:vertical, #sbScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---- 节头 ---- */
#sbSectionHead { background: transparent; border: none; }
#sbSectionHead[clickable="true"] { cursor: pointinghand; }
#sbSectionHead[clickable="true"]:hover { background: rgba(0, 0, 0, 8); border-radius: 5px; }
#sbSectionTitle {
    color: rgb(96, 96, 96);
    font: bold 12px "Segoe UI";
}
#sbSectionCount {
    color: rgb(120, 120, 120);
    font: 12px "Consolas";
}
#sbSectionArrow { background: transparent; }
#sbSectionBody { background: transparent; border: none; }

/* ---- 上下文占用条 ---- */
#ctxTrack {
    background: rgba(0, 0, 0, 20);
    border-radius: 3px;
}
#ctxFill {
    background: rgb(0, 90, 158);
    border-radius: 3px;
}
#ctxFill[level="warn"] {
    background: rgb(194, 127, 0);
}
#ctxNumbers {
    color: rgb(96, 96, 96);
    font: 11px "Consolas";
}

/* ---- 状态灯行（waiting 与消息流审批卡同语言：淡染底 + 左描边） ---- */
#statusRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#statusRow[state="running"] { background: rgba(0, 90, 158, 14); }
#statusRow[state="waiting"] {
    background: rgba(194, 127, 0, 16);
    border-left: 3px solid rgba(194, 127, 0, 170);
}
#statusDot { font: 11px "Segoe UI"; color: rgb(120, 120, 120); background: transparent; }
#statusText {
    color: rgb(96, 96, 96);
    font: 12px "Segoe UI";
    background: transparent;
}
#statusRow[state="running"] #statusDot, #statusRow[state="running"] #statusText { color: rgb(0, 90, 158); }
#statusRow[state="running"] #statusText { font-weight: bold; }
#statusRow[state="waiting"] #statusDot, #statusRow[state="waiting"] #statusText { color: rgb(194, 127, 0); }
#statusRow[state="waiting"] #statusText { font-weight: bold; }

/* ---- TODO / 文件行 ---- */
#sbRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#sbMark { font: 12px "Segoe UI"; color: rgb(120, 120, 120); background: transparent; }
#sbText {
    color: rgb(96, 96, 96);
    font: 12px "Segoe UI";
    background: transparent;
}
#sbRow[status="active"] {
    background: rgba(194, 127, 0, 14);
    border-left: 3px solid rgba(194, 127, 0, 160);
}
#sbRow[status="active"] #sbMark { color: rgb(194, 127, 0); }
#sbRow[status="active"] #sbText { color: rgb(60, 60, 60); font-weight: bold; }
#sbRow[status="done"] #sbMark { color: rgb(16, 124, 16); }
#sbRow[status="done"] #sbText { color: rgb(120, 120, 120); }
#sbRow[kind="write"] #sbMark { color: rgb(16, 124, 16); }
#sbRow[kind="edit"] #sbMark { color: rgb(0, 90, 158); }
#sbEmptyHint {
    color: rgb(153, 153, 153);
    font: italic 12px "Segoe UI";
    background: transparent;
    padding-left: 8px;
}

/* ---- 页脚 ---- */
#sbFooterDir {
    color: rgb(110, 110, 110);
    font: 11px "Consolas";
    background: transparent;
}
#sbFooterVersion {
    color: rgb(153, 153, 153);
    font: 11px "Consolas";
    background: transparent;
}
