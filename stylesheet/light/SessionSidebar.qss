/* light —— SessionSidebar 会话侧边栏 */

#SessionSidebar {
    /* 底色与左侧导航列对齐（LiteHarnessNavAlign.qss 基准） */
    background: rgb(249, 249, 249);
    border: none;
    /* 左/顶边框线与左侧导航列边框同源取色 */
    border-left: 1px solid rgb(210, 210, 210);
    border-top: 1px solid rgb(210, 210, 210);
}

/* ---- 面板头部 ---- */
#sbPanelTitle {
    color: rgb(96, 96, 96);
    font: bold 12px "Segoe UI";
}
#sidebarHideBtn, #sidebarRestoreBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
#sidebarHideBtn:hover, #sidebarRestoreBtn:hover {
    background: rgba(0, 0, 0, 18);
}
#sidebarHideBtn:pressed, #sidebarRestoreBtn:pressed {
    background: rgba(0, 0, 0, 32);
}

/* ---- 会话标题 / 模型 ---- */
#sbSessTitle {
    color: rgb(60, 60, 60);
    font: bold 15px "Segoe UI";
}
#sbSessModel {
    color: rgb(92, 92, 92);
    font: 12px "Consolas";
}
#sbSeparator {
    background: rgba(0, 0, 0, 40);
    border: none;
}

/* ---- 滚动容器透明（透出面板底色） ---- */
#sbScroll { background: transparent; border: none; }
#sbScroll > QWidget > QWidget { background: transparent; border: none; }
#sbScrollInner { background: transparent; }
#sbScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 1px 2px 1px;
}
#sbScroll QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 42);
    border-radius: 3px;
    min-height: 28px;
}
#sbScroll QScrollBar::add-line:vertical, #sbScroll QScrollBar::sub-line:vertical {
    height: 0;
}
#sbScroll QScrollBar::add-page:vertical, #sbScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---- 节头 ---- */
#sbSectionHead { background: transparent; border: none; }
/* 可折叠节头预置 1px 透明边框：焦点态只换描边色而不改变边框宽度，
   避免头部内容在 hover/focus 之间位移 1px（本节走 QVBoxLayout 自然布局，无手动几何） */
#sbSectionHead[clickable="true"] { cursor: pointinghand; border: 1px solid transparent; border-radius: 5px; }
#sbSectionHead[clickable="true"]:hover { background: rgba(0, 0, 0, 8); }
/* 键盘可达（P1-6）：节头已进 Tab 链，必须给可见焦点环（描边取本主题强调色） */
#sbSectionHead[clickable="true"]:focus { border: 1px solid rgb(0, 90, 158); background: rgba(0, 90, 158, 18); }
#sbSectionTitle {
    color: rgb(96, 96, 96);
    font: bold 12px "Segoe UI";
}
#sbSectionCount {
    color: rgb(92, 92, 92);
    font: 12px "Consolas";
}
#sbSectionArrow { background: transparent; }
#sbSectionBody { background: transparent; border: none; }

/* ---- 上下文占用（条 + 精确数字行；数字与条同一读数——单源 usageRatio，收起侧栏一并不可见是明示代价）---- */
#ctxTrack {
    background: rgba(0, 0, 0, 20);
    border-radius: 3px;
}
#ctxFill {
    background: rgb(0, 90, 158);
    border-radius: 3px;
}
#ctxFill[level="warn"] {
    background: rgb(194, 127, 0);
}
#ctxNumbers {
    color: rgb(96, 96, 96);
    font: 11px "Consolas";
}

/* ---- 运行状态灯（waiting 与消息流审批卡同语言：淡染底，无描边） ---- */
/* 单侧 border 会让行内容右移 3px（行 setContentsMargins 8,0,8,0 之下 QSS 盒模型
   把 border 画在控件矩形内侧），与 #sbRow[status="active"] 同理由一并去除 */
#statusRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#statusRow[state="running"] { background: rgba(0, 90, 158, 14); }
#statusRow[state="waiting"] {
    background: rgba(194, 127, 0, 16);
}
#statusDot { font: 11px "Segoe UI"; color: rgb(92, 92, 92); background: transparent; }
#statusText {
    color: rgb(96, 96, 96);
    font: 12px "Segoe UI";
    background: transparent;
}
#statusRow[state="running"] #statusDot, #statusRow[state="running"] #statusText { color: rgb(0, 90, 158); }
#statusRow[state="running"] #statusText { font-weight: bold; }
#statusRow[state="waiting"] #statusDot, #statusRow[state="waiting"] #statusText { color: rgb(151, 99, 0); }
#statusRow[state="waiting"] #statusText { font-weight: bold; }

/* ---- TODO / 文件行 ---- */
#sbRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#sbMark { font: 12px "Segoe UI"; color: rgb(92, 92, 92); background: transparent; }
#sbText {
    color: rgb(96, 96, 96);
    font: 12px "Segoe UI";
    background: transparent;
}
#sbRow[status="active"] {
    background: rgba(194, 127, 0, 14);
}
#sbRow[status="active"] #sbMark { color: rgb(151, 99, 0); }
#sbRow[status="active"] #sbText { color: rgb(60, 60, 60); font-weight: bold; }
#sbRow[status="done"] #sbMark { color: rgb(16, 124, 16); }
#sbRow[status="done"] #sbText { color: rgb(92, 92, 92); }
/* s17 P1 后台任务失败行（bg failed 态）：红点灰字，与 done 同降级权重——终局留痕不抢进行中行 */
#sbRow[status="failed"] #sbMark { color: rgb(196, 43, 44); }
#sbRow[status="failed"] #sbText { color: rgb(92, 92, 92); }
#sbEmptyHint {
    color: rgb(104, 104, 104);
    font: italic 12px "Segoe UI";
    background: transparent;
    padding-left: 8px;
}

/* ---- 页脚 ---- */
#sbFooterDir {
    color: rgb(110, 110, 110);
    font: 11px "Consolas";
    background: transparent;
}
#sbFooterVersion {
    color: rgb(104, 104, 104);
    font: 11px "Consolas";
    background: transparent;
}
