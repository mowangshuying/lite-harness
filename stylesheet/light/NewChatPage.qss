NewChatPage {
    background-color: rgb(249, 249, 249);
    border-top-left-radius: 8px;
    border: 1px solid rgb(229, 229, 229);
}

/* 英雄页问候语：页面唯一大字（字号在 QSS 定义，QLabel 渲染无测量问题） */
NewChatPage QLabel#welcomeLabel {
    color: rgb(50, 50, 50);
    font-size: 26px;
    font-weight: 600;
}

/* 工作目录行：12px 次要信息，题头比路径更浅一档，整体弱于输入框 */
NewChatPage QLabel#workDirCaption {
    color: rgb(153, 153, 153);
}

NewChatPage QLabel#workDirPath {
    color: rgb(110, 110, 110);
}

/* 「浏览」：透明扁平文字钮，仅 hover 提亮为强调色，不抢焦点 */
NewChatPage QToolButton#workDirBrowse {
    color: rgb(110, 110, 110);
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px 8px;
}

NewChatPage QToolButton#workDirBrowse:hover {
    color: rgb(0, 90, 158);
    background-color: rgba(0, 0, 0, 10);
}

NewChatPage QToolButton#workDirBrowse:pressed {
    color: rgb(0, 90, 158);
    background-color: rgba(0, 0, 0, 20);
}