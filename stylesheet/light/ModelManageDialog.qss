ModelManageDialog {
    background-color: transparent;
}

ModelManageDialog QWidget#windowMask {
    background-color: rgba(74, 74, 74, 0.7);
}

ModelManageDialog QFrame#centerWidget {
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
}

ModelManageDialog QLabel#dialogTitle {
    font-size: 15px;
    font-weight: bold;
    color: rgb(27, 27, 27);
    background-color: transparent;
}

ModelManageDialog QLabel#serviceLabel {
    font-size: 13px;
    color: rgb(96, 96, 96);
    background-color: transparent;
}

ModelManageDialog QLabel#serviceValue {
    font-size: 13px;
    color: rgb(27, 27, 27);
    background-color: transparent;
}

ModelManageDialog QLabel#emptyHint {
    font-size: 13px;
    color: rgb(96, 96, 96);
    background-color: transparent;
}

ModelManageDialog QLabel#colHeader {
    font-size: 13px;
    color: rgb(96, 96, 96);
    background-color: transparent;
}

ModelManageDialog QLabel#rowName {
    font-size: 12px;
    color: rgb(27, 27, 27);
    background-color: transparent;
}

ModelManageDialog QLabel#footerInfo {
    font-size: 12px;
    color: rgb(96, 96, 96);
    background-color: transparent;
}

ModelManageDialog QScrollArea {
    background-color: transparent;
    border: none;
}

ModelManageDialog QWidget#modelPage {
    background-color: transparent;
}

ModelManageDialog QWidget#btnWidget {
    background-color: rgb(243, 243, 243);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}