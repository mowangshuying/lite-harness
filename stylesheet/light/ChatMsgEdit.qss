ChatMsgEdit {
    background-color: rgb(249, 249, 249);
    border: 2px solid rgba(0, 0, 0, 12);
    border-radius: 10px;
}

ChatMsgEdit[focused="true"] {
    border: 2px solid rgb(0, 90, 158);
}

#textEdit {
    background-color: rgb(249, 249, 249);
    border: 1px solid transparent;
    color: rgb(26, 26, 26);
}