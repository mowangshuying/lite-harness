/* light */
ToolBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(243,243,243) = 原 rgba(0,0,0,6) 叠加 ChatSessionPage 底色 rgb(249,249,249) 的合成实色 */
#toolHeader {
    background-color: rgb(243, 243, 243);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(0,0,0,13) 叠加页底色的合成值 */
#toolHeader:hover {
    background-color: rgb(236, 236, 236);
}

#toolIcon {
    color: rgb(96, 96, 96);
    font-family: Consolas, "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

/* 非 bash 工具的等宽名字标签（read_file / write_file / edit_file / glob）：
   弱底圆角小片，颜色与命令行同级，突出"哪个工具" */
#toolTag {
    color: rgb(60, 60, 60);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: rgba(0, 0, 0, 10);
    border-radius: 4px;
    padding: 1px 6px;
}

/* 语义类别着色：ToolTagKind.h 给标签打上 toolTagKind 动态属性
   （read / search / write / run / plan / delegate），只回答“这是哪类工具”，
   不承载执行结果语义（头部没有状态色，只有中性图标 + 中文词条）。
   未知工具归 other，保持上面的中性小片底色。
   注：bash 在头部显示 “$” 提示符而非工具名标签，它的 run 色只在 PermissionCard 可见。 */
#toolTag[toolTagKind="read"] {
    color: rgb(30, 96, 176);
    background-color: rgba(30, 96, 176, 18);
}
#toolTag[toolTagKind="search"] {
    color: rgb(0, 128, 152);
    background-color: rgba(0, 128, 152, 18);
}
#toolTag[toolTagKind="write"] {
    color: rgb(142, 76, 172);
    background-color: rgba(142, 76, 172, 18);
}
#toolTag[toolTagKind="run"] {
    color: rgb(190, 100, 30);
    background-color: rgba(190, 100, 30, 18);
}
#toolTag[toolTagKind="plan"] {
    color: rgb(150, 110, 20);
    background-color: rgba(150, 110, 20, 18);
}
#toolTag[toolTagKind="delegate"] {
    color: rgb(40, 128, 70);
    background-color: rgba(40, 128, 70, 18);
}

#toolTitle {
    color: rgb(96, 96, 96);
    font-size: 13px;
}

/* 命令行：等宽字体，颜色比标题略重，突出"模型执行了什么" */
#toolCommand {
    color: rgb(60, 60, 60);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#toolOutput {
    background-color: rgba(0, 0, 0, 3);
    border-left: 2px solid rgba(0, 0, 0, 24);
    padding: 4px 8px;
    color: rgb(120, 120, 120);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}
