/* light */
/* 工具输出查看器：骨架色值与 FluentInputDialog.qss 同源（遮罩/卡片/按钮行三件套），
   内容区等宽配色与 ToolBlock.qss 的 #toolOutput 同源，避免同一份输出在两处显出两种色。 */

ToolOutputDialog {
    background-color: transparent;
}

ToolOutputDialog QWidget#windowMask {
    background-color: rgba(74, 74, 74, 0.7);
}

ToolOutputDialog QFrame#centerWidget {
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
}

ToolOutputDialog QLabel#titleLabel {
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

/* meta 行：字符数与上游截断提示，弱于标题一档，但必须可读（它承载诚实性声明） */
ToolOutputDialog QLabel#metaLabel {
    font-size: 12px;
    color: rgb(91, 91, 91);
    background-color: transparent;
}

/* 内容区：实色底 + 描边圆角，与卡片白底拉开一档对比；等宽字体承托长行横向滚动 */
ToolOutputDialog QTextBrowser#outputBody {
    background-color: rgb(243, 243, 243);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 6px;
    margin: 0 24px;
    padding: 4px 8px;
    color: rgb(50, 50, 50);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

ToolOutputDialog QWidget#btnWidget {
    background-color: rgb(243, 243, 243);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
