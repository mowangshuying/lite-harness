ChatMsgEdit {
    background-color: rgb(40, 40, 40);
    border: 2px solid rgba(255, 255, 255, 42);
    border-radius: 10px;
}

ChatMsgEdit[focused="true"] {
    border: 2px solid rgb(118, 185, 237);
}

#textEdit {
    background-color: rgb(40, 40, 40);
    border: 1px solid transparent;
    color: rgb(255, 255, 255);
    /* 空态引导字色（ChatMsgEdit::setPlaceholderText）：placeholder 只能由这条
       Qt6 原生 QSS 属性着色（palette 的 PlaceholderText 会被本样式表的 re-polish
       覆盖回默认值，故不在 C++ 里设）。 */
    placeholder-text-color: rgb(140, 140, 140);
}

/* 运行中（turn busy）禁用态：此前只 setEnabled(false)，而 QSS 又显式写了 color，
   禁用时不会退回 palette 灰 —— 整个回合（秒级到分钟级）输入框与可用态外观完全相同，
   点了没反应像是界面卡死。这里只降一档字色表达禁用；**底色沿用正常态**（用户裁决：
   压暗底色会让输入框看起来"陷下去"，与周围面板断开）。 */
#textEdit:disabled {
    background-color: rgb(40, 40, 40);
    color: rgb(140, 140, 140);
}
