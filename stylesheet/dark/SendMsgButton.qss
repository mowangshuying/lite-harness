SendMsgButton {
    background-color: transparent;
    border: 1px solid rgb(56, 56, 56);
    border-radius: 15px;
}

SendMsgButton:hover {
    background-color: rgba(255, 255, 255, 15);
}

SendMsgButton:pressed {
    background-color: rgba(255, 255, 255, 25);
}

SendMsgButton:disabled {
    background-color: transparent;
}

/* 停止形态（回合运行中）：强调蓝淡染（dark 主题 accent 118,196,237 一档提亮，
   与侧栏 running 灯同源；琥珀专属审批警示不占用），
   hover/pressed 逐档加深（属性选择器置后，压过中性态规则） */
SendMsgButton[stopMode="true"] {
    background-color: rgba(118, 185, 237, 20);
    border: 1px solid rgba(118, 185, 237, 120);
}

SendMsgButton[stopMode="true"]:hover {
    background-color: rgba(118, 185, 237, 36);
}

SendMsgButton[stopMode="true"]:pressed {
    background-color: rgba(118, 185, 237, 52);
}
