/* dark */
ThinkingBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(43,43,43) = 原 rgba(255,255,255,4) 叠加 ChatSessionPage 底色 rgb(40,40,40) 的合成实色 */
#thinkingHeader {
    background-color: rgb(43, 43, 43);
    border: 1px solid rgba(255, 255, 255, 8);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(255,255,255,8) 叠加页底色的合成值 */
#thinkingHeader:hover {
    background-color: rgb(47, 47, 47);
}

/* 键盘可达（P1-6）：与 ToolBlock #toolHeader:focus 同一套口径（1px 描边换色 + hover 之上提亮一档） */
#thinkingHeader:focus {
    border: 1px solid rgb(118, 185, 237);
    background-color: rgb(55, 55, 55);
}

/* 标题对比度对齐 light/atom（原 153 CR 4.97 偏低）：163 灰 CR 5.61，给预览留出可读层级 */
#thinkingTitle {
    color: rgb(163, 163, 163);
    font-size: 13px;
}

/* 进行态预览行（P1）：思考期间块保持折叠，最新输出行显示在头部。
   比标题淡一档 —— 它是「正在输出的片段」，不是需要读的结论。
   色值保 ≥4.5:1（叠头部底 43）：148 灰 CR 4.67，仍淡于标题 163（CR 5.61） */
#thinkingPreview {
    color: rgb(148, 148, 148);
    font-size: 12px;
}

#thinkingContent {
    background-color: rgba(255, 255, 255, 2);
    border-left: 2px solid rgba(255, 255, 255, 12);
    padding: 4px 8px;
    color: rgb(163, 163, 163);
}