FluentInputDialog {
    background-color: transparent;
}

FluentInputDialog QWidget#windowMask {
    background-color: rgba(0, 0, 0, 0.7);
}

FluentInputDialog QFrame#centerWidget {
    background-color: rgb(43, 43, 43);
    border-radius: 8px;
}

FluentInputDialog QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    background-color: transparent;
}

FluentInputDialog QLabel#infoLabel {
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: transparent;
}

FluentInputDialog QWidget#btnWidget {
    background-color: rgb(32, 32, 32);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
