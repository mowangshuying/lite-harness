/* dark */
ToolBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(43,43,43) = 原 rgba(255,255,255,4) 叠加 ChatSessionPage 底色 rgb(40,40,40) 的合成实色 */
#toolHeader {
    background-color: rgb(43, 43, 43);
    border: 1px solid rgba(255, 255, 255, 8);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(255,255,255,8) 叠加页底色的合成值 */
#toolHeader:hover {
    background-color: rgb(47, 47, 47);
}

/* 键盘可达（P1-6）：折叠头已进 Tab 链，必须给可见焦点环。
   暗底上「更显眼」= 更亮，故底色在 hover 之上再提一档；描边取本主题强调色
   （与 ChatSessionPage 用户气泡同值 rgb(118,185,237)，不引入新色值）。
   边框宽度维持基础态 1px——头部走手动几何，加粗会挤动内容。 */
#toolHeader:focus {
    border: 1px solid rgb(118, 185, 237);
    background-color: rgb(55, 55, 55);
}

#toolIcon {
    color: rgb(153, 153, 153);
    font-family: Consolas, "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

/* 非 bash 工具的等宽名字标签（read_file / write_file / edit_file / glob）：
   弱底圆角小片，颜色与命令行同级，突出"哪个工具" */
#toolTag {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 14);
    border-radius: 4px;
    padding: 1px 6px;
}

/* 语义类别着色：ToolTagKind.h 给标签打上 toolTagKind 动态属性
   （read / search / write / run / plan / delegate），只回答“这是哪类工具”，
   不承载执行结果语义（头部没有状态色，只有中性图标 + 中文词条）。
   未知工具归 other，保持上面的中性小片底色。
   注：bash 在头部显示 “$” 提示符而非工具名标签，它的 run 色只在 PermissionCard 可见。 */
#toolTag[toolTagKind="read"] {
    color: rgb(126, 180, 230);
    background-color: rgba(126, 180, 230, 30);
}
#toolTag[toolTagKind="search"] {
    color: rgb(115, 200, 214);
    background-color: rgba(115, 200, 214, 30);
}
#toolTag[toolTagKind="write"] {
    color: rgb(198, 146, 226);
    background-color: rgba(198, 146, 226, 30);
}
#toolTag[toolTagKind="run"] {
    color: rgb(235, 160, 90);
    background-color: rgba(235, 160, 90, 30);
}
#toolTag[toolTagKind="plan"] {
    color: rgb(226, 190, 105);
    background-color: rgba(226, 190, 105, 30);
}
#toolTag[toolTagKind="delegate"] {
    color: rgb(140, 205, 152);
    background-color: rgba(140, 205, 152, 30);
}

#toolTitle {
    color: rgb(153, 153, 153);
    font-size: 13px;
}

/* 命令行：等宽字体，颜色比标题略亮，突出"模型执行了什么" */
#toolCommand {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#toolOutput {
    background-color: rgba(255, 255, 255, 2);
    border-left: 2px solid rgba(255, 255, 255, 12);
    padding: 4px 8px;
    color: rgb(163, 163, 163);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* 成败字形位（B1，ToolBlock::applyOutcome 打 outcome 动态属性）：
   状态色只上此处字形，不染工具名标签（类别色与状态色分层，兑现 ToolTagKind 注释承诺）。
   ✓ 绿 = 成功终态；✕ 红 = 失败/被拒；■ 灰 = 中断无结果 */
QLabel#toolOutcome {
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
    font-weight: bold;
}
QLabel#toolOutcome[outcome="ok"] {
    color: rgb(108, 203, 91);
}
QLabel#toolOutcome[outcome="fail"] {
    color: rgb(255, 102, 82);
}
QLabel#toolOutcome[outcome="stopped"] {
    color: rgb(163, 163, 163);
}

/* 「查看完整输出」入口钮：图标由 FluIconUtils 按主题取色，此处只管交互态底与焦点环。
   基础态完全透明——它坐在不透明头部之上，常态不该抢视觉重心，hover/focus 才现身。 */
QToolButton#toolViewAll {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}

/* hover 实色 = 与 #toolHeader:hover 同档的一档提亮（43→47 那档） */
QToolButton#toolViewAll:hover {
    background-color: rgb(47, 47, 47);
}

/* 按下态（P2-C2）：本钮是 QToolButton（非 QWidget 头部），:pressed 真实生效。
   暗色主题按既有阶梯继续提亮（base 43 → hover 47 → focus 55 → pressed 62），
   与本主题「越活跃越亮」的口径一致，不引入反向的加深档。 */
QToolButton#toolViewAll:pressed {
    background-color: rgb(62, 62, 62);
}

/* 键盘可达：本钮已进 Tab 链（StrongFocus），焦点环取本主题 #toolHeader:focus 同色 */
QToolButton#toolViewAll:focus {
    border: 1px solid rgb(118, 185, 237);
    background-color: rgb(55, 55, 55);
}
