/* dark */
ToolBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(43,43,43) = 原 rgba(255,255,255,4) 叠加 ChatSessionPage 底色 rgb(40,40,40) 的合成实色 */
#toolHeader {
    background-color: rgb(43, 43, 43);
    border: 1px solid rgba(255, 255, 255, 8);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(255,255,255,8) 叠加页底色的合成值 */
#toolHeader:hover {
    background-color: rgb(47, 47, 47);
}

#toolIcon {
    color: rgb(153, 153, 153);
    font-family: Consolas, "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

/* 非 bash 工具的等宽名字标签（read_file / write_file / edit_file / glob）：
   弱底圆角小片，颜色与命令行同级，突出"哪个工具" */
#toolTag {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 14);
    border-radius: 4px;
    padding: 1px 6px;
}

/* 语义类别着色：ToolTagKind.h 给标签打上 toolTagKind 动态属性
   （read / search / write / run / plan / delegate），只回答“这是哪类工具”，
   不承载执行结果语义（头部没有状态色，只有中性图标 + 中文词条）。
   未知工具归 other，保持上面的中性小片底色。
   注：bash 在头部显示 “$” 提示符而非工具名标签，它的 run 色只在 PermissionCard 可见。 */
#toolTag[toolTagKind="read"] {
    color: rgb(126, 180, 230);
    background-color: rgba(126, 180, 230, 30);
}
#toolTag[toolTagKind="search"] {
    color: rgb(115, 200, 214);
    background-color: rgba(115, 200, 214, 30);
}
#toolTag[toolTagKind="write"] {
    color: rgb(198, 146, 226);
    background-color: rgba(198, 146, 226, 30);
}
#toolTag[toolTagKind="run"] {
    color: rgb(235, 160, 90);
    background-color: rgba(235, 160, 90, 30);
}
#toolTag[toolTagKind="plan"] {
    color: rgb(226, 190, 105);
    background-color: rgba(226, 190, 105, 30);
}
#toolTag[toolTagKind="delegate"] {
    color: rgb(140, 205, 152);
    background-color: rgba(140, 205, 152, 30);
}

#toolTitle {
    color: rgb(153, 153, 153);
    font-size: 13px;
}

/* 命令行：等宽字体，颜色比标题略亮，突出"模型执行了什么" */
#toolCommand {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#toolOutput {
    background-color: rgba(255, 255, 255, 2);
    border-left: 2px solid rgba(255, 255, 255, 12);
    padding: 4px 8px;
    color: rgb(136, 136, 136);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}
