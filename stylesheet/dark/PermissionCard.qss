/* dark */
PermissionCard {
    background-color: transparent;
}

/* 待决主体：琥珀淡染底 + 细描边，叠加页底色 rgb(40,40,40) */
#pcBody {
    background-color: rgba(255, 196, 10, 12);
    border: 1px solid rgba(255, 196, 10, 45);
    border-radius: 6px;
}

/* 圆形警示徽章：亮琥珀底深色感叹号（深底上提亮保证对比） */
#pcBadge {
    background-color: rgb(255, 196, 10);
    border-radius: 9px;
    color: rgb(32, 32, 32);
    font-size: 12px;
    font-weight: bold;
}

#pcTitle {
    color: rgb(220, 220, 220);
    font-size: 14px;
    font-weight: bold;
}

/* 等宽工具名标签：与 ToolBlock #toolTag 同款小片 */
#pcTag {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 14);
    border-radius: 4px;
    padding: 1px 6px;
}

/* 语义类别着色：与 ToolBlock #toolTag 共用 ToolTagKind.h 的类别属性，
   同一工具在待决卡片与历史块里显示同一种颜色 */
#pcTag[toolTagKind="read"] {
    color: rgb(126, 180, 230);
    background-color: rgba(126, 180, 230, 30);
}
#pcTag[toolTagKind="search"] {
    color: rgb(115, 200, 214);
    background-color: rgba(115, 200, 214, 30);
}
#pcTag[toolTagKind="write"] {
    color: rgb(198, 146, 226);
    background-color: rgba(198, 146, 226, 30);
}
#pcTag[toolTagKind="run"] {
    color: rgb(235, 160, 90);
    background-color: rgba(235, 160, 90, 30);
}
#pcTag[toolTagKind="plan"] {
    color: rgb(226, 190, 105);
    background-color: rgba(226, 190, 105, 30);
}
#pcTag[toolTagKind="delegate"] {
    color: rgb(140, 205, 152);
    background-color: rgba(140, 205, 152, 30);
}

#pcVerb {
    color: rgb(153, 153, 153);
    font-size: 13px;
}

/* 关键参数：等宽字体，与工具块命令行同级观感 */
#pcSummary {
    color: rgb(200, 200, 200);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* 风险原因：提亮琥珀，深底可读 */
#pcReason {
    color: rgb(255, 214, 122);
    font-size: 12px;
}

/* 拒绝按钮：Fluent 深色标准按钮，默认焦点所在（安全动作占默认位） */
#pcDenyButton {
    background-color: rgb(51, 51, 51);
    border: 1px solid rgba(255, 255, 255, 22);
    border-radius: 4px;
    padding: 0 16px;
    color: rgb(220, 220, 220);
    font-size: 13px;
}
#pcDenyButton:hover {
    background-color: rgb(57, 57, 57);
}
#pcDenyButton:pressed {
    background-color: rgb(48, 48, 48);
    color: rgb(170, 170, 170);
}
#pcDenyButton:focus {
    border: 1px solid rgb(153, 153, 153);
}

/* 允许按钮：琥珀描边、弱于拒绝一档，避免危险操作获得高对比默认确认 */
#pcAllowButton {
    background-color: transparent;
    border: 1px solid rgba(255, 196, 10, 120);
    border-radius: 4px;
    padding: 0 16px;
    color: rgb(255, 214, 122);
    font-size: 13px;
}
#pcAllowButton:hover {
    background-color: rgba(255, 196, 10, 18);
}
#pcAllowButton:pressed {
    background-color: rgba(255, 196, 10, 28);
}

/* 裁决留痕：弱化单行。允许显绿；拒绝为安全动作，保持中性灰不施红 */
#pcTrace {
    background-color: transparent;
}
#pcTraceIcon {
    font-size: 13px;
    font-weight: bold;
    color: rgb(136, 136, 136);
}
#pcTraceIcon[outcome="allowed"] {
    color: rgb(108, 203, 91);
}
#pcTraceLabel {
    color: rgb(136, 136, 136);
    font-size: 13px;
}
