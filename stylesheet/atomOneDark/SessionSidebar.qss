/* atomOneDark —— SessionSidebar 会话侧边栏 */

#SessionSidebar {
    /* 底色与左侧导航列对齐（LiteHarnessNavAlign.qss 基准） */
    background: rgb(40, 44, 52);
    border: none;
    /* 左/顶边框线与左侧导航列边框同源取色 */
    border-left: 1px solid rgb(56, 60, 68);
    border-top: 1px solid rgb(56, 60, 68);
}

/* ---- 面板头部 ---- */
#sbPanelTitle {
    color: rgb(171, 178, 191);
    font: bold 12px "Segoe UI";
}
#sidebarHideBtn, #sidebarRestoreBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
#sidebarHideBtn:hover, #sidebarRestoreBtn:hover {
    background: rgba(255, 255, 255, 14);
}
#sidebarHideBtn:pressed, #sidebarRestoreBtn:pressed {
    background: rgba(255, 255, 255, 24);
}

/* ---- 会话标题 / 模型 ---- */
#sbSessTitle {
    color: rgb(210, 214, 222);
    font: bold 15px "Segoe UI";
}
#sbSessModel {
    color: rgb(139, 148, 158);
    font: 12px "Consolas";
}
#sbSeparator {
    background: rgb(56, 60, 68);
    border: none;
}

/* ---- 滚动容器透明（透出面板底色） ---- */
#sbScroll { background: transparent; border: none; }
#sbScroll > QWidget > QWidget { background: transparent; border: none; }
#sbScrollInner { background: transparent; }
#sbScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 1px 2px 1px;
}
#sbScroll QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 40);
    border-radius: 3px;
    min-height: 28px;
}
#sbScroll QScrollBar::add-line:vertical, #sbScroll QScrollBar::sub-line:vertical {
    height: 0;
}
#sbScroll QScrollBar::add-page:vertical, #sbScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---- 节头 ---- */
#sbSectionHead { background: transparent; border: none; }
#sbSectionHead[clickable="true"] { cursor: pointinghand; }
#sbSectionHead[clickable="true"]:hover { background: rgba(255, 255, 255, 8); border-radius: 5px; }
#sbSectionTitle {
    color: rgb(171, 178, 191);
    font: bold 12px "Segoe UI";
}
#sbSectionCount {
    color: rgb(139, 148, 158);
    font: 12px "Consolas";
}
#sbSectionArrow { background: transparent; }
#sbSectionBody { background: transparent; border: none; }

/* ---- 上下文占用条 ---- */
#ctxTrack {
    background: rgba(255, 255, 255, 16);
    border-radius: 3px;
}
#ctxFill {
    background: rgb(82, 139, 255);
    border-radius: 3px;
}
#ctxFill[level="warn"] {
    background: rgb(229, 192, 123);
}
#ctxNumbers {
    color: rgb(171, 178, 191);
    font: 11px "Consolas";
}

/* ---- 状态灯行（waiting 与消息流审批卡同语言：淡染底 + 左描边） ---- */
#statusRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#statusRow[state="running"] { background: rgba(82, 139, 255, 18); }
#statusRow[state="waiting"] {
    background: rgba(229, 192, 123, 16);
    border-left: 3px solid rgba(229, 192, 123, 160);
}
#statusDot { font: 11px "Segoe UI"; color: rgb(139, 148, 158); background: transparent; }
#statusText {
    color: rgb(171, 178, 191);
    font: 12px "Segoe UI";
    background: transparent;
}
#statusRow[state="running"] #statusDot, #statusRow[state="running"] #statusText { color: rgb(82, 139, 255); }
#statusRow[state="running"] #statusText { font-weight: bold; }
#statusRow[state="waiting"] #statusDot, #statusRow[state="waiting"] #statusText { color: rgb(229, 192, 123); }
#statusRow[state="waiting"] #statusText { font-weight: bold; }

/* ---- TODO / 文件行 ---- */
#sbRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#sbMark { font: 12px "Segoe UI"; color: rgb(139, 148, 158); background: transparent; }
#sbText {
    color: rgb(171, 178, 191);
    font: 12px "Segoe UI";
    background: transparent;
}
#sbRow[status="active"] {
    background: rgba(229, 192, 123, 14);
    border-left: 3px solid rgba(229, 192, 123, 150);
}
#sbRow[status="active"] #sbMark { color: rgb(229, 192, 123); }
#sbRow[status="active"] #sbText { color: rgb(212, 216, 224); font-weight: bold; }
#sbRow[status="done"] #sbMark { color: rgb(152, 195, 121); }
#sbRow[status="done"] #sbText { color: rgb(139, 148, 158); }
#sbRow[kind="write"] #sbMark { color: rgb(152, 195, 121); }
#sbRow[kind="edit"] #sbMark { color: rgb(82, 139, 255); }
#sbEmptyHint {
    color: rgb(115, 122, 135);
    font: italic 12px "Segoe UI";
    background: transparent;
    padding-left: 8px;
}

/* ---- 页脚 ---- */
#sbFooterDir {
    color: rgb(150, 157, 170);
    font: 11px "Consolas";
    background: transparent;
}
#sbFooterVersion {
    color: rgb(115, 122, 135);
    font: 11px "Consolas";
    background: transparent;
}
