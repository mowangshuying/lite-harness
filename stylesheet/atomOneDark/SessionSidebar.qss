/* atomOneDark —— SessionSidebar 会话侧边栏 */

#SessionSidebar {
    /* 底色取 FluentUI 原生导航带色 rgb(33,37,43)（与 LiteHarnessNavAlign.qss 同源）。
       注意本侧栏在页面内部**最右**（src/ChatSessionPage.cpp:172-176：左列 + 侧栏），
       与左侧导航列同色但不相邻 ⇒ 形成「左导航带 33,37,43 / 中内容列 40,44,52 /
       右侧栏 33,37,43」的三道分层，分界靠色差而非线，故 s17.7 起删掉了原先的 border-left。 */
    background: rgb(33, 37, 43);
    border: none;
    /* 顶边描边取 atomOneDark 描边基准 rgb(71,74,79)（FluentUI 原生控件描边色，
       与卡片描边 / SendMsgButton / #jumpBottomBtn 同源） */
    border-top: 1px solid rgb(71, 74, 79);
}

/* ---- 面板头部 ---- */
#sbPanelTitle {
    color: rgb(171, 178, 191);
    font: bold 12px "Segoe UI";
}
#sidebarHideBtn, #sidebarRestoreBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
#sidebarHideBtn:hover, #sidebarRestoreBtn:hover {
    background: rgba(255, 255, 255, 14);
}
#sidebarHideBtn:pressed, #sidebarRestoreBtn:pressed {
    background: rgba(255, 255, 255, 24);
}

/* ---- 会话标题 / 模型 ---- */
#sbSessTitle {
    color: rgb(210, 214, 222);
    font: bold 15px "Segoe UI";
}
#sbSessModel {
    color: rgb(147, 157, 167);
    font: 12px "Consolas";
}
#sbSeparator {
    /* 分隔条底色随本主题描边基准（s17.7 起 71,74,79） */
    background: rgb(71, 74, 79);
    border: none;
}

/* ---- 滚动容器透明（透出面板底色） ---- */
#sbScroll { background: transparent; border: none; }
#sbScroll > QWidget > QWidget { background: transparent; border: none; }
#sbScrollInner { background: transparent; }
#sbScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 1px 2px 1px;
}
#sbScroll QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 40);
    border-radius: 3px;
    min-height: 28px;
}
#sbScroll QScrollBar::add-line:vertical, #sbScroll QScrollBar::sub-line:vertical {
    height: 0;
}
#sbScroll QScrollBar::add-page:vertical, #sbScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---- 节头 ---- */
#sbSectionHead { background: transparent; border: none; }
/* 可折叠节头预置 1px 透明边框：焦点态只换描边色而不改变边框宽度，
   避免头部内容在 hover/focus 之间位移 1px（本节走 QVBoxLayout 自然布局，无手动几何）。
   手型光标不在 QSS 里设：Qt 样式表没有 cursor 属性（此前的 cursor: pointinghand
   是解析期静默丢弃的死声明），改由 SidebarSection::setCollapsible 按可折叠性设置。 */
#sbSectionHead[clickable="true"] { border: 1px solid transparent; border-radius: 5px; }
#sbSectionHead[clickable="true"]:hover { background: rgba(255, 255, 255, 8); }
/* 键盘可达（P1-6）：节头已进 Tab 链，必须给可见焦点环（描边取本主题强调色） */
#sbSectionHead[clickable="true"]:focus { border: 1px solid rgb(82, 139, 255); background: rgba(82, 139, 255, 24); }
#sbSectionTitle {
    color: rgb(171, 178, 191);
    font: bold 12px "Segoe UI";
}
#sbSectionCount {
    color: rgb(147, 157, 167);
    font: 12px "Consolas";
}
#sbSectionArrow { background: transparent; }
#sbSectionBody { background: transparent; border: none; }

/* ---- 上下文占用（条 + 精确数字行；数字与条同一读数——单源 usageRatio，收起侧栏一并不可见是明示代价）---- */
#ctxTrack {
    background: rgba(255, 255, 255, 16);
    border-radius: 3px;
}
#ctxFill {
    background: rgb(82, 139, 255);
    border-radius: 3px;
}
#ctxFill[level="warn"] {
    background: rgb(229, 192, 123);
}
#ctxNumbers {
    color: rgb(171, 178, 191);
    font: 11px "Consolas";
}

/* ---- 运行状态灯（waiting 与消息流审批卡同语言：淡染底，无描边） ---- */
/* 单侧 border 会让行内容右移 3px（行 setContentsMargins 8,0,8,0 之下 QSS 盒模型
   把 border 画在控件矩形内侧），与 #sbRow[status="active"] 同理由一并去除 */
#statusRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#statusRow[state="running"] { background: rgba(82, 139, 255, 18); }
#statusRow[state="waiting"] {
    background: rgba(229, 192, 123, 16);
}
#statusDot { font: 11px "Segoe UI"; color: rgb(147, 157, 167); background: transparent; }
#statusText {
    color: rgb(171, 178, 191);
    font: 12px "Segoe UI";
    background: transparent;
}
#statusRow[state="running"] #statusDot, #statusRow[state="running"] #statusText { color: rgb(92, 156, 255); }
#statusRow[state="running"] #statusText { font-weight: bold; }
#statusRow[state="waiting"] #statusDot, #statusRow[state="waiting"] #statusText { color: rgb(229, 192, 123); }
#statusRow[state="waiting"] #statusText { font-weight: bold; }

/* ---- TODO / 文件行 ---- */
#sbRow {
    background: transparent;
    border: none;
    border-radius: 5px;
}
#sbMark { font: 12px "Segoe UI"; color: rgb(147, 157, 167); background: transparent; }
#sbText {
    color: rgb(171, 178, 191);
    font: 12px "Segoe UI";
    background: transparent;
}
#sbRow[status="active"] {
    background: rgba(229, 192, 123, 14);
}
#sbRow[status="active"] #sbMark { color: rgb(229, 192, 123); }
#sbRow[status="active"] #sbText { color: rgb(212, 216, 224); font-weight: bold; }
#sbRow[status="done"] #sbMark { color: rgb(152, 195, 121); }
#sbRow[status="done"] #sbText { color: rgb(147, 157, 167); }
/* s17 P1 后台任务失败行（bg failed 态）：红点灰字，与 done 同降级权重——终局留痕不抢进行中行 */
#sbRow[status="failed"] #sbMark { color: rgb(242, 117, 126); }
#sbRow[status="failed"] #sbText { color: rgb(147, 157, 167); }
#sbEmptyHint {
    color: rgb(148, 157, 174);
    font: italic 12px "Segoe UI";
    background: transparent;
    padding-left: 8px;
}

/* ---- 页脚 ---- */
#sbFooterDir {
    color: rgb(150, 157, 170);
    font: 11px "Consolas";
    background: transparent;
}
#sbFooterVersion {
    color: rgb(148, 157, 174);
    font: 11px "Consolas";
    background: transparent;
}
