/* atomOneDark */
ToolBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(43,47,55) = 原 rgba(255,255,255,4) 叠加 ChatSessionPage 底色 rgb(40,44,52) 的合成实色 */
#toolHeader {
    background-color: rgb(43, 47, 55);
    border: 1px solid rgb(56, 60, 68);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(255,255,255,8) 叠加页底色的合成值 */
#toolHeader:hover {
    background-color: rgb(47, 51, 58);
}

/* 键盘可达（P1-6）：折叠头已进 Tab 链，必须给可见焦点环。
   暗底上「更显眼」= 更亮，故底色在 hover 之上再提一档；描边取本主题强调色
   （与 ChatSessionPage 用户气泡同值 rgb(82,139,255)，不引入新色值）。
   边框宽度维持基础态 1px——头部走手动几何，加粗会挤动内容。 */
#toolHeader:focus {
    border: 1px solid rgb(82, 139, 255);
    background-color: rgb(55, 59, 66);
}

#toolIcon {
    color: rgb(171, 178, 191);
    font-family: Consolas, "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

/* 非 bash 工具的等宽名字标签（read_file / write_file / edit_file / glob）：
   弱底圆角小片，颜色与命令行同级，突出"哪个工具" */
#toolTag {
    color: rgb(212, 216, 224);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 16);
    border-radius: 4px;
    padding: 1px 6px;
}

/* 语义类别着色：ToolTagKind.h 给标签打上 toolTagKind 动态属性
   （read / search / write / run / plan / delegate），只回答“这是哪类工具”，
   不承载执行结果语义（头部没有状态色，只有中性图标 + 中文词条）。
   未知工具归 other，保持上面的中性小片底色。
   注：bash 在头部显示 “$” 提示符而非工具名标签，它的 run 色只在 PermissionCard 可见。 */
#toolTag[toolTagKind="read"] {
    color: rgb(97, 175, 239);
    background-color: rgba(97, 175, 239, 28);
}
#toolTag[toolTagKind="search"] {
    color: rgb(86, 182, 194);
    background-color: rgba(86, 182, 194, 28);
}
#toolTag[toolTagKind="write"] {
    color: rgb(186, 141, 221);
    background-color: rgba(186, 141, 221, 28);
}
#toolTag[toolTagKind="run"] {
    color: rgb(209, 154, 102);
    background-color: rgba(209, 154, 102, 28);
}
#toolTag[toolTagKind="plan"] {
    color: rgb(229, 192, 123);
    background-color: rgba(229, 192, 123, 28);
}
#toolTag[toolTagKind="delegate"] {
    color: rgb(152, 195, 121);
    background-color: rgba(152, 195, 121, 28);
}

#toolTitle {
    color: rgb(171, 178, 191);
    font-size: 13px;
}

/* 命令行：等宽字体，颜色比标题略亮，突出"模型执行了什么" */
#toolCommand {
    color: rgb(212, 216, 224);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#toolOutput {
    background-color: rgba(255, 255, 255, 3);
    border-left: 2px solid rgb(62, 68, 81);
    padding: 4px 8px;
    color: rgb(147, 157, 167);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* 成败字形位（B1，ToolBlock::applyOutcome 打 outcome 动态属性）：
   状态色只上此处字形，不染工具名标签（类别色与状态色分层，兑现 ToolTagKind 注释承诺）。
   ✓ 绿 = 成功终态；✕ 红 = 失败/被拒；■ 灰 = 中断无结果 */
QLabel#toolOutcome {
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
    font-weight: bold;
}
QLabel#toolOutcome[outcome="ok"] {
    color: rgb(152, 195, 121);
}
QLabel#toolOutcome[outcome="fail"] {
    color: rgb(242, 117, 126);
}
QLabel#toolOutcome[outcome="stopped"] {
    color: rgb(147, 157, 167);
}

/* 「查看完整输出」入口钮：图标由 FluIconUtils 按主题取色，此处只管交互态底与焦点环。
   基础态完全透明——它坐在不透明头部之上，常态不该抢视觉重心，hover/focus 才现身。 */
QToolButton#toolViewAll {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}

/* hover 实色 = 与 #toolHeader:hover 同档的一档提亮（43,47,55 → 47,51,58） */
QToolButton#toolViewAll:hover {
    background-color: rgb(47, 51, 58);
}

/* 按下态（P2-C2）：本钮是 QToolButton（非 QWidget 头部），:pressed 真实生效。
   暗色主题按既有阶梯继续提亮（base 43,47,55 → hover 47,51,58 → focus 55,59,66
   → pressed 62,66,73），与本主题「越活跃越亮」的口径一致。 */
QToolButton#toolViewAll:pressed {
    background-color: rgb(62, 66, 73);
}

/* 键盘可达：本钮已进 Tab 链（StrongFocus），焦点环取本主题 #toolHeader:focus 同色 */
QToolButton#toolViewAll:focus {
    border: 1px solid rgb(82, 139, 255);
    background-color: rgb(55, 59, 66);
}
