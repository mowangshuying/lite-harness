SendMsgButton {
    background-color: transparent;
    border: 1px solid rgb(56, 60, 68);
    border-radius: 15px;
}

SendMsgButton:hover {
    background-color: rgba(255, 255, 255, 15);
}

SendMsgButton:pressed {
    background-color: rgba(255, 255, 255, 25);
}

SendMsgButton:disabled {
    background-color: transparent;
}

/* 停止形态（回合运行中）：atomOneDark 强调蓝 #528BFF 淡染（与侧栏 running 灯
   同源；语法黄专属审批警示不占用），冷灰底上保持辨识度
   （属性选择器置后，压过中性态规则） */
SendMsgButton[stopMode="true"] {
    background-color: rgba(82, 139, 255, 20);
    border: 1px solid rgba(82, 139, 255, 120);
}

SendMsgButton[stopMode="true"]:hover {
    background-color: rgba(82, 139, 255, 36);
}

SendMsgButton[stopMode="true"]:pressed {
    background-color: rgba(82, 139, 255, 52);
}
