ChatSessionPage {
    background-color: rgb(40, 44, 52);
    border-top-left-radius: 8px;
    border: 1px solid rgb(56, 60, 68);
}

MessageBubbleWidget {
    background-color: transparent;
}

#msgBrowser[role="User"] {
    background-color: rgb(82, 139, 255);
    border-radius: 10px;
    color: rgb(255, 255, 255);
}

#msgBrowser[role="Assistant"] {
    background: transparent;
    color: rgb(171, 178, 191);
}

#msgBrowser[role="Assistant"] blockquote {
    color: rgb(128, 128, 128);
    font-style: italic;
    border-left: 3px solid rgba(128, 128, 128, 80);
    margin-left: 4px;
    padding-left: 8px;
}

/* 只读工作目录页眉：12px 次要灰字（字号在代码设定以对齐 elide 量纲），
   题头比路径更浅一档，与 NewChatPage 路径条同一套灰阶 token（灰阶取 Atom 前景/注释之间） */
ChatSessionPage QLabel#workDirCaption {
    color: rgb(115, 122, 135);
}

ChatSessionPage QLabel#workDirPath {
    color: rgb(150, 157, 170);
}