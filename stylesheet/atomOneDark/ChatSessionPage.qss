ChatSessionPage {
    background-color: rgb(40, 44, 52);
    border-top-left-radius: 8px;
    border: 1px solid rgb(71, 74, 79);
}

MessageBubbleWidget {
    background-color: transparent;
}

#msgBrowser[role="User"] {
    background-color: rgb(82, 139, 255);
    border-radius: 10px;
    color: rgb(255, 255, 255);
}

#msgBrowser[role="Assistant"] {
    background: transparent;
    color: rgb(171, 178, 191);
}

/* 文档内 blockquote / pre / code 的样式**不在这里**：Qt 样式表只匹配 QWidget，
   setMarkdown 生成的富文本内容根本不参与选择器匹配（本条此前是一条解析期
   静默丢弃的死规则，三套主题各写了一遍）。实际样式见
   MessageBubbleWidget::makeTextView 的 QTextDocument::setDefaultStyleSheet，
   取值半透明灰，三主题共用一份、无需随主题切换重刷。 */

/* 只读工作目录页眉：12px 次要灰字（字号在代码设定以对齐 elide 量纲），
   题头比路径更浅一档，与 NewChatPage 路径条同一套灰阶 token（灰阶取 Atom 前景/注释之间） */
ChatSessionPage QLabel#workDirCaption {
    color: rgb(148, 157, 174);
}

ChatSessionPage QLabel#workDirPath {
    color: rgb(150, 157, 170);
}

/* P1-9 空态引导卡：空会话时消息列唯一内容，读作「面板」而非「气泡」——
   比气泡更淡的底 + 一圈弱边，标题比正文重一档，正文三行走次要灰阶
   （与 workDir* 同一族灰阶，避免引导抢走对真实回复的注意力） */
ChatSessionPage QWidget#emptyHint {
    background-color: rgb(46, 51, 60);
    border: 1px solid rgb(78, 85, 96);
    border-radius: 10px;
}

ChatSessionPage QLabel#emptyHintTitle {
    color: rgb(182, 189, 202);
    font-size: 14px;
    font-weight: 600;
}

ChatSessionPage QLabel#emptyHintLine {
    color: rgb(140, 148, 162);
    font-size: 12px;
}

/* 「回到底部」浮动钮（评审 B1）：此前全仓零规则，钮体吃 Qt 原生绘制——而它浮在
   消息流之上，与 #sidebarRestoreBtn（嵌在工具条里、transparent 底成立）**不同**：
   这里必须实底，否则气泡文字会从钮体底下透出来。底色取本页底色同源、描边取页面
   描边同源，圆角 16px 按 32×32 定出正圆（命中区下限 32px 见 LayoutConstants；
   与 SendMsgButton 的 30×30/15px 已分档，勿再按「同规格」理解）。
   hover/pressed 逐档加深沿用 SendMsgButton 的 alpha 阶梯，保证两个圆形动作钮手感一致。 */
ChatSessionPage QToolButton#jumpBottomBtn {
    background-color: rgb(40, 44, 52);
    border: 1px solid rgb(71, 74, 79);
    border-radius: 16px;
}

/* hover/pressed 用**合成实色**而非 rgba 半透明：本钮浮在消息气泡之上，半透明底会让
   气泡文字从钮体透出（与 #sidebarRestoreBtn 嵌在工具条里的情形不同）。
   合成口径与 ThinkingBlock.qss 同源：rgba(255,255,255,a) 逐通道叠页底色 40,44,52。
   hover = +15 → 55,59,67；pressed = +25 → 65,69,77（alpha 阶梯取 SendMsgButton 同档）。 */
ChatSessionPage QToolButton#jumpBottomBtn:hover {
    background-color: rgb(55, 59, 67);
}

ChatSessionPage QToolButton#jumpBottomBtn:pressed {
    background-color: rgb(65, 69, 77);
}
