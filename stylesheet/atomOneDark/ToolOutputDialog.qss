/* atomOneDark */
/* 工具输出查看器：骨架色值与 FluentInputDialog.qss 同源（卡片 rgb(44,48,54) / 按钮行 rgb(50,54,60)），
   内容区等宽配色与 ToolBlock.qss 的 #toolOutput 同源，避免同一份输出在两处显出两种色。 */

ToolOutputDialog {
    background-color: transparent;
}

ToolOutputDialog QWidget#windowMask {
    background-color: rgba(0, 0, 0, 0.7);
}

ToolOutputDialog QFrame#centerWidget {
    background-color: rgb(44, 48, 54);
    border-radius: 8px;
}

ToolOutputDialog QLabel#titleLabel {
    font-size: 16px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    background-color: transparent;
}

/* meta 行：字符数与上游截断提示，取本主题 #toolOutput 的前景色（147,157,167）同档弱化 */
ToolOutputDialog QLabel#metaLabel {
    font-size: 12px;
    color: rgb(147, 157, 167);
    background-color: transparent;
}

/* 内容区：比卡片底（44,48,54）略暗一档拉开层次；描边取本主题既有的 (62,68,81) */
ToolOutputDialog QTextBrowser#outputBody {
    background-color: rgb(36, 40, 47);
    border: 1px solid rgb(62, 68, 81);
    border-radius: 6px;
    margin: 0 24px;
    padding: 4px 8px;
    color: rgb(171, 178, 191);
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

ToolOutputDialog QWidget#btnWidget {
    background-color: rgb(50, 54, 60);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
