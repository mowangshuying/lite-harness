/* atomOneDark */
ThinkingBlock {
    background-color: transparent;
}

/* 实色底色：动画为 FluExpander 式头部遮挡滑出，需不透明底色遮住滑入头部背后的内容。
   rgb(43,47,55) = 原 rgba(255,255,255,4) 叠加 ChatSessionPage 底色 rgb(40,44,52) 的合成实色 */
#thinkingHeader {
    background-color: rgb(43, 47, 55);
    border: 1px solid rgb(56, 60, 68);
    border-radius: 6px;
}

/* hover 实色 = 原 rgba(255,255,255,8) 叠加页底色的合成值 */
#thinkingHeader:hover {
    background-color: rgb(47, 51, 58);
}

/* 键盘可达（P1-6）：与 ToolBlock #toolHeader:focus 同一套口径（1px 描边换色 + hover 之上提亮一档） */
#thinkingHeader:focus {
    border: 1px solid rgb(82, 139, 255);
    background-color: rgb(55, 59, 66);
}

#thinkingTitle {
    color: rgb(171, 178, 191);
    font-size: 13px;
}

/* 进行态预览行（P1）：思考期间块保持折叠，最新输出行显示在头部。
   比标题淡一档 —— 它是「正在输出的片段」，不是需要读的结论 */
#thinkingPreview {
    color: rgb(130, 137, 150);
    font-size: 12px;
}

#thinkingContent {
    background-color: rgba(255, 255, 255, 3);
    border-left: 2px solid rgb(62, 68, 81);
    padding: 4px 8px;
    color: rgb(147, 157, 167);
}